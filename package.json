{
  "name": "studyworld-cloudflare",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=12.4.2 <13"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "lint": "eslint src test scripts public/assets/app.js eslint.config.mjs",
    "test": "node --test test/*.test.js",
    "syntax": "node scripts/check-syntax.mjs",
    "check": "pnpm run syntax && pnpm run lint && pnpm run test",
    "db:migrate:local": "wrangler d1 migrations apply studyworld-prod --local",
    "db:migrate:remote": "wrangler d1 migrations apply studyworld-prod --remote",
    "lighthouse": "lhci autorun",
    "quality": "pnpm run check && pnpm run lighthouse",
    "predeploy": "pnpm run check && node scripts/predeploy-check.mjs"
  },
  "devDependencies": {
    "@lhci/cli": "0.15.1",
    "eslint": "10.11.0",
    "wrangler": "4.135.0"
  }
}
